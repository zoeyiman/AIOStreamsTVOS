+type ForYouKind = 'all' | 'Movie' | 'Series';
+
+function ForYou() {
+  const { client, user } = useSession();
+  const [kind, setKind] = React.useState<ForYouKind>('all');
+  const trackerHistory = useFeature('history');
+  const suggestions = useQuery({
+    queryKey: [...useKey(), 'tv-for-you', trackerHistory],
+    staleTime: 10 * 60_000,
+    queryFn: async () => {
+      const params = {
+        userId: user.Id,
+        Recursive: true,
+        IncludeItemTypes: 'Movie,Series,Episode',
+        Fields: 'Genres',
+      };
+      const [history, favorites, tracked] = await Promise.all([
+        client.get<{ Items?: BaseItemDto[] }>('/Items', {
+          ...params,
+          Filters: 'IsPlayed',
+          SortBy: 'DatePlayed',
+          SortOrder: 'Descending',
+          Limit: 60,
+        }),
+        client.get<{ Items?: BaseItemDto[] }>('/Items', {
+          ...params,
+          Filters: 'IsFavorite',
+          Limit: 36,
+        }),
+        trackerHistory
+          ? client
+              .get<HistoryPage>('/AIOStreams/History', { userId: user.Id })
+              .catch(() => undefined)
+          : undefined,
+      ]);
+      const ids = (items: BaseItemDto[]) => [
+        ...new Set(
+          items
+            .map((item) => (item.Type === 'Episode' ? item.SeriesId : item.Id))
+            .filter((id): id is string => !!id)
+        ),
+      ];
+      const watchedById = new Map<string, BaseItemDto>();
+      for (const item of [
+        ...(history.Items ?? []).filter((item) => item.UserData?.Played),
+        ...(tracked?.items ?? [])
+          .filter((entry) => entry.played)
+          .map((entry) => entry.item),
+      ]) {
+        if (item.Id && !watchedById.has(item.Id))
+          watchedById.set(item.Id, item);
+      }
+      const watched = [...watchedById.values()];
+      const saved = favorites.Items ?? [];
+      const seen = new Set([...ids(watched), ...ids(saved)]);
+      const trackerSeeds = ids(
+        (tracked?.items ?? [])
+          .filter((entry) => entry.played)
+          .map((entry) => entry.item)
+      );
+      const seeds = [
+        ...new Set([
+          ...ids(watched).slice(0, 10),
+          ...trackerSeeds.slice(0, 5),
+          ...ids(saved).slice(0, 5),
+        ]),
+      ];
+      const requests = seeds.map((id) =>
+        client
+          .get<{ Items?: BaseItemDto[] }>(`/Items/${id}/Similar`, {
+            userId: user.Id,
+            Limit: 14,
+            Fields: 'Genres',
+            EnableUserData: true,
+          })
+          .then((result) => result.Items ?? [])
+          .catch((): BaseItemDto[] => [])
+      );
+      const genres = new Map<string, number>();
+      for (const item of watched) {
+        for (const genre of item.Genres ?? [])
+          genres.set(genre, (genres.get(genre) ?? 0) + 1);
+      }
+      const discoveryGenres = [...genres]
+        .sort((a, b) => b[1] - a[1])
+        .slice(0, 3);
+      for (const [genre] of discoveryGenres) {
+        requests.push(
+          client
+            .get<{ Items?: BaseItemDto[] }>('/Items', {
+              ...params,
+              IncludeItemTypes: 'Movie,Series',
+              Genres: genre,
+              Filters: 'IsUnplayed',
+              SortBy: 'CommunityRating',
+              SortOrder: 'Descending',
+              Limit: 20,
+            })
+            .then((result) => result.Items ?? [])
+            .catch((): BaseItemDto[] => [])
+        );
+      }
+      const rows = await Promise.all(requests);
+      const picks: BaseItemDto[] = [];
+      for (
+        let index = 0;
+        index < Math.max(0, ...rows.map((row) => row.length));
+        index++
+      ) {
+        for (const row of rows) {
+          const item = row[index];
+          if (
+            !item?.Id ||
+            seen.has(item.Id) ||
+            (item.Type !== 'Movie' && item.Type !== 'Series') ||
+            item.UserData?.Played ||
+            item.UserData?.IsFavorite ||
+            item.UserData?.Likes === false
+          )
+            continue;
+          seen.add(item.Id);
+          picks.push(item);
+        }
+      }
+      return picks.slice(0, 84);
+    },
+  });
+  const items = (suggestions.data ?? []).filter(
+    (item) => kind === 'all' || item.Type === kind
+  );
+  return (
+    <div className="space-y-5 px-4 pb-16 pt-6 lg:pe-10">
+      <h1 data-ui="page-title" className="text-3xl font-bold">
+        <Trans>Discover</Trans>
+      </h1>
+      <div className="flex flex-wrap items-center gap-3">
+        <PillTabs<ForYouKind>
+          name="recommendation-kind"
+          value={kind}
+          onChange={setKind}
+          options={[
+            { value: 'all', label: t`All` },
+            { value: 'Movie', label: t`Movies` },
+            { value: 'Series', label: t`Shows` },
+          ]}
+        />
+      </div>
+      <h2 className="text-xl font-semibold">
+        <Trans>For you</Trans>
+      </h2>
+      {suggestions.isError ? (
+        <LuffyError title={t`Could not load recommendations`} />
+      ) : (
+        <div data-nav-start>
+          <MixedGrid
+            items={items}
+            client={client}
+            loading={suggestions.isLoading}
+            columns={6}
+          />
+          {!suggestions.isLoading && !items.length && (
+            <p>
+              <Trans>No recommendations yet.</Trans>
+            </p>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
