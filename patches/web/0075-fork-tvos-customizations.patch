+/** The Apple TV search keyboard and results share one focus tree. */
+function AppleSearchKeyboard({
+  term,
+  onChange,
+}: {
+  term: string;
+  onChange: React.Dispatch<React.SetStateAction<string>>;
+}) {
+  const [symbols, setSymbols] = React.useState(false);
+  const keys = symbols
+    ? '1234567890-_.!@#$%^&*+/:?'
+    : 'abcdefghijklmnopqrstuvwxyz';
+  const append = (key: string) => onChange((value) => value + key);
+  const erase = () =>
+    onChange((value) => Array.from(value).slice(0, -1).join(''));
+  const keyStyle =
+    'flex h-10 min-w-0 items-center justify-center rounded-lg text-lg text-white/75 focus-visible:bg-white focus-visible:text-black';
+  const utilityStyle = cn(
+    keyStyle,
+    'shrink-0 bg-white/10 px-2 text-xs font-semibold'
+  );
+
+  return (
+    <section
+      data-ui="apple-inline-search"
+      className="space-y-3 border-b border-white/20 pb-3"
+    >
+      <div className="flex min-h-10 items-center gap-3">
+        <BiSearch aria-hidden className="shrink-0 text-2xl" />
+        <h1
+          aria-live="polite"
+          className="min-w-0 flex-1 truncate text-2xl font-semibold"
+        >
+          {term || t`Search`}
+        </h1>
+      </div>
+      <div
+        data-nav-start
+        data-nav-group
+        className="flex w-full items-center gap-0.5"
+        onKeyDown={(event) => {
+          if (event.altKey || event.ctrlKey || event.metaKey) return;
+          if (event.key === 'Backspace') erase();
+          else if (event.key !== ' ' && Array.from(event.key).length === 1)
+            append(event.key);
+          else return;
+          event.preventDefault();
+        }}
+      >
+        <button
+          type="button"
+          data-focus="own"
+          className={utilityStyle}
+          onClick={() => setSymbols(!symbols)}
+        >
+          {symbols ? 'ABC' : '123'}
+        </button>
+        <button
+          type="button"
+          data-focus="own"
+          className={utilityStyle}
+          onClick={() => append(' ')}
+        >
+          <Trans>Space</Trans>
+        </button>
+        {Array.from(keys, (key) => (
+          <button
+            key={key}
+            type="button"
+            data-focus="own"
+            className={cn(keyStyle, 'flex-1')}
+            onClick={() => append(key)}
+          >
+            {key}
+          </button>
+        ))}
+        <button
+          type="button"
+          data-focus="own"
+          aria-label={t`Delete`}
+          className={cn(utilityStyle, 'px-2.5')}
+          onClick={erase}
+        >
+          <BiArrowBack aria-hidden className="text-lg" />
+        </button>
+      </div>
+    </section>
+  );
+}
