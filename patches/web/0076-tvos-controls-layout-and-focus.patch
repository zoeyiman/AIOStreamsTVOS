+[data-tv] .UI-Switch__root[data-state='checked'] {
+  background: #5de29b;
+  border-color: #5de29b;
+}
+[data-tv] .UI-Switch__root[data-state='checked'] .UI-Switch__thumb {
+  background: #101a15;
+}
+
+[data-tv] [data-ui='live-tv'] {
+  padding-block-end: max(1rem, env(safe-area-inset-bottom));
+}
+
+[data-tv] [data-ui='live-side'] {
+  overflow-y: auto;
+}
+
+[data-tv] [data-apple-sources] {
+  width: min(94vw, 88rem);
+  max-width: none;
+  height: min(87vh, 52rem);
+  background: #1b1d23;
+}
+[data-tv] [data-apple-sources] [data-ui='version'] {
+  background: rgb(255 255 255 / .09);
+}
+[data-tv] [data-apple-sources] [data-ui='version']:focus-within {
+  background: rgb(255 255 255 / .19);
+}
+[data-tv] [data-apple-sources] [data-ui='versions-banner'],
+[data-tv] [data-apple-sources] [data-ui='version-play-icon'] {
+  display: none;
+}
+
+[data-tv] .UI-Drawer__content[data-ui='dialog'],
+[data-tv] [data-ui='player-menu'] {
+  border: 1px solid rgb(255 255 255 / .23);
+  border-radius: 1.5rem;
+  background: rgb(38 40 48 / .88);
+  -webkit-backdrop-filter: blur(24px) saturate(140%);
+  backdrop-filter: blur(24px) saturate(140%);
+  box-shadow: 0 16px 48px rgb(0 0 0 / .45), inset 0 1px rgb(255 255 255 / .1);
+}
+
+[data-tv] [data-apple-transport] {
+  display: flex;
+  flex-direction: column;
+  padding-inline: max(3vw, 2rem);
+  padding-bottom: max(2vh, 1rem);
+}
+[data-tv] [data-apple-transport] [data-ui='player-transport-actions'] { order: 0; }
+[data-tv] [data-apple-transport] [data-ui='seek-bar'] { order: 1; }
+[data-tv] [data-apple-transport] [data-ui='player-info'] { order: 2; }
+[data-tv] [data-apple-transport] [data-ui='seek-bar-progress'] { background: white; }
+[data-tv] [data-apple-transport] [data-ui='seek-bar-thumb'] {
+  width: .25rem;
+  border-radius: .2rem;
+}
+[data-tv] [data-apple-transport] [data-ui='player-button']:not(:focus-visible) {
+  border: 1px solid rgb(255 255 255 / .32);
+  background: rgb(255 255 255 / .14);
+}
+
+[data-tv] [data-hide-pip] [data-name='tvos-pip'] {
+  display: none;
+}
+
+[data-tv] .UI-Modal__content[data-ui='dialog']:not([data-apple-sources]),
+[data-tv] [data-ui='player-menu'] {
+  -webkit-backdrop-filter: blur(24px) saturate(140%);
+  backdrop-filter: blur(24px) saturate(140%);
+}
