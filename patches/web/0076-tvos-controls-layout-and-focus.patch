diff --git a/packages/web/src/lib/settings/tv-visibility.ts b/packages/web/src/lib/settings/tv-visibility.ts
new file mode 100644
index 0000000..17d643e
--- /dev/null
+++ b/packages/web/src/lib/settings/tv-visibility.ts
@@ -0,0 +1,9 @@
+import { appleTv } from '@/lib/hosts/shell/bridge';
+import { settings, useSetting } from '@/lib/settings';
+
+export type TvControlSurface = 'navigation' | 'player' | 'detail';
+
+export function useVisibleTvControls(surface: TvControlSurface) {
+  const [hidden] = useSetting(settings.tvVisibility);
+  return (name: string) => !appleTv() || !hidden[surface]?.includes(name);
+}
