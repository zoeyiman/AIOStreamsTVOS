@@ -0,0 +1,87 @@
+import { t } from '@lingui/core/macro';
+import { Switch } from '@aiostreams/ui/switch';
+import { appleTv } from '@/lib/hosts/shell/bridge';
+import { settings, useSetting } from '@/lib/settings';
+
+import type { TvControlSurface } from '@/lib/settings/tv-visibility';
+
+export function TvVisibility({
+  surface,
+  options,
+}: {
+  surface: TvControlSurface;
+  options: readonly (readonly [string, string])[];
+}) {
+  const [hidden, setHidden] = useSetting(settings.tvVisibility);
+  if (!appleTv()) return null;
+  const selected = hidden[surface] ?? [];
+  return options.map(([name, label]) => (
+    <Switch
+      key={name}
+      label={label}
+      side="right"
+      value={!selected.includes(name)}
+      onValueChange={(visible) =>
+        setHidden({
+          ...hidden,
+          [surface]: visible
+            ? selected.filter((entry) => entry !== name)
+            : [...selected, name],
+        })
+      }
+    />
+  ));
+}
+
+export const detailOptions = () =>
+  [
+    ['play', t`Play`],
+    ['restart', t`Play from the start`],
+    ['trailer', t`Trailer`],
+    ['random', t`Random episode`],
+    ['party', t`Watch party`],
+    ['play-on', t`Play on`],
+    ['add-to-playlist', t`Add to playlist`],
+    ['watched', t`Watched`],
+    ['favourite', t`Favorites`],
+    ['drop', t`Drop show`],
+    ['rating', t`Rate`],
+    ['download', t`Download`],
+  ] as const;
+
+export const playerOptions = () =>
+  [
+    ['clock', t`Clock`],
+    ['seek-bar', t`Progress bar`],
+    ['time', t`Time remaining`],
+    ['previous', t`Previous episode`],
+    ['next', t`Next episode`],
+    ['back', t`Skip back`],
+    ['forward', t`Skip forward`],
+    ['audio', t`Audio`],
+    ['subtitles', t`Subtitles`],
+    ['quality', t`Quality`],
+    ['episodes', t`Episodes`],
+    ['versions', t`Versions`],
+    ['playlist', t`Playlist`],
+    ['channels', t`Channels`],
+    ['recent-channels', t`Recently watched`],
+    ['party', t`Watch party`],
+    ['statistics', t`Statistics`],
+    ['lock', t`Lock`],
+    ['picture-in-picture', t`Picture-in-picture`],
+    ['skip-segment', t`Skip`],
+    ['pause-info', t`Info when paused`],
+  ] as const;
+
+export const navigationOptions = () =>
+  [
+    ['home', t`Home`],
+    ['discover', t`Discover`],
+    ['search', t`Search`],
+    ['favourites', t`Favorites`],
+    ['live', t`Live TV`],
+    ['downloads', t`Downloads`],
+    ['account', t`Account`],
+    ['settings', t`Settings`],
+  ] as const;
