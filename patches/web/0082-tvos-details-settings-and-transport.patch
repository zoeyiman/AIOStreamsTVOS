+function TabOrderCard() {
+  const [visibility, setVisibility] = useSetting(settings.tvVisibility);
+  const options = navigationOptions().filter(
+    ([id]) => id !== 'account' && id !== 'settings'
+  );
+  const order = orderedTvTabs(
+    options.map(([id]) => id),
+    visibility.order ?? []
+  );
+  const hidden = visibility.navigation ?? [];
+  const label = (id: string) => options.find(([key]) => key === id)?.[1] ?? id;
+  const move = (index: number, offset: number) => {
+    const nextIndex = index + offset;
+    if (nextIndex < 0 || nextIndex >= order.length) return;
+    const next = [...order];
+    [next[index], next[nextIndex]] = [next[nextIndex], next[index]];
+    setVisibility({ ...visibility, order: next });
+  };
+  return (
+    <SettingsCard name="tab-order" title={t`Tab order`}>
+      {order.map((id, index) => {
+        const name = label(id);
+        const enabled = !hidden.includes(id);
+        return (
+          <div key={id} className="flex items-center justify-between gap-2">
+            <span className="font-medium">{name}</span>
+            <div className="flex items-center gap-2">
+              <IconButton
+                size="sm"
+                intent="gray-subtle"
+                className="rounded-full"
+                icon={enabled ? <BiShow /> : <BiHide />}
+                aria-label={enabled ? t`Hide ${name}` : t`Show ${name}`}
+                aria-pressed={enabled}
+                onClick={() =>
+                  setVisibility({
+                    ...visibility,
+                    navigation: enabled
+                      ? [...hidden, id]
+                      : hidden.filter((entry) => entry !== id),
+                  })
+                }
+              />
+              <IconButton
+                size="sm"
+                intent="gray-subtle"
+                className="rounded-full"
+                icon={<BiChevronUp />}
+                aria-label={t`Move ${name} up`}
+                aria-disabled={index === 0}
+                onClick={() => move(index, -1)}
+              />
+              <IconButton
+                size="sm"
+                intent="gray-subtle"
+                className="rounded-full"
+                icon={<BiChevronDown />}
+                aria-label={t`Move ${name} down`}
+                aria-disabled={index === order.length - 1}
+                onClick={() => move(index, 1)}
+              />
+            </div>
+          </div>
+        );
+      })}
+      <Button
+        size="sm"
+        intent="gray-subtle"
+        onClick={() => setVisibility({ ...visibility, order: [] })}
+      >
+        {t`Restore default order`}
+      </Button>
+    </SettingsCard>
+  );
+}
