diff --git a/packages/web/src/features/live-tv/now-playing.tsx b/packages/web/src/features/live-tv/now-playing.tsx
new file mode 100644
index 0000000..03048c6
--- /dev/null
+++ b/packages/web/src/features/live-tv/now-playing.tsx
@@ -0,0 +1,57 @@
+import { Trans } from '@lingui/react/macro';
+import { BiMusic } from 'react-icons/bi';
+import { CachedImage } from '@/components/cached-image';
+import { posterUrl } from '@/lib/artwork/urls';
+import { appleTv } from '@/lib/hosts/shell/bridge';
+import { useSession } from '@/lib/jellyfin/session';
+import type { BaseItemDto } from '@/lib/jellyfin/types';
+
+export function LiveNowPlaying({
+  programme,
+}: {
+  programme: BaseItemDto | undefined;
+}) {
+  const { client } = useSession();
+  // Music-aware providers can supply the track separately from the EPG title.
+  const metadata = programme as
+    | (BaseItemDto & { NowPlaying?: { Title?: string; Artist?: string } })
+    | undefined;
+  const text = (value: unknown) =>
+    typeof value === 'string' ? value.trim() : '';
+  const artists = Array.isArray(programme?.Artists)
+    ? programme.Artists.map(text).filter(Boolean).join(', ')
+    : '';
+  const title =
+    text(metadata?.NowPlaying?.Title) || (artists ? text(programme?.Name) : '');
+  const artist = text(metadata?.NowPlaying?.Artist) || artists;
+  if (!appleTv() || !title || !artist) return null;
+  const artwork = programme?.ImageTags?.Primary
+    ? posterUrl(client, programme, { maxWidth: 240 })
+    : null;
+
+  return (
+    <div
+      data-ui="live-now-playing"
+      className="flex w-fit max-w-full items-center gap-3 rounded-xl bg-black/60 px-3 py-2 text-white"
+    >
+      <span className="grid size-12 shrink-0 place-items-center overflow-hidden rounded-lg bg-white/10">
+        {artwork ? (
+          <CachedImage
+            src={artwork}
+            alt=""
+            className="size-full object-cover"
+          />
+        ) : (
+          <BiMusic aria-hidden className="text-2xl" />
+        )}
+      </span>
+      <div className="min-w-0">
+        <p className="text-xs font-semibold text-white/65">
+          <Trans>Now playing</Trans>
+        </p>
+        <p className="truncate font-semibold">{title}</p>
+        <p className="truncate text-sm text-white/75">{artist}</p>
+      </div>
+    </div>
+  );
+}
