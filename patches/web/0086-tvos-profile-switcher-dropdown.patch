+
+/** Compact Apple TV profile menu, kept over the current page. */
+export function TvProfileSwitcher() {
+  const { user, switchUser } = useSession();
+  const profiles = usePickableUsers();
+  const [error, setError] = React.useState(false);
+  const [open, setOpen] = React.useState(false);
+  const [busy, setBusy] = React.useState(false);
+  const colors = ['#9751c9', '#369bd0', '#d53c78', '#578c73'];
+  const choices = profiles.data ?? [{ user, avatar: null, needs: null }];
+  return (
+    <DropdownMenu
+      data-ui="tv-profile-menu"
+      open={open}
+      onOpenChange={(next) => {
+        if (!busy) {
+          setOpen(next);
+          setError(false);
+        }
+      }}
+      align="end"
+      sideOffset={16}
+      className="w-80 rounded-3xl border-white/25 bg-neutral-900/90 p-3 text-white shadow-2xl backdrop-blur-2xl"
+      itemClass="gap-4 rounded-2xl px-3 py-3 text-xl focus:bg-white/20 data-[highlighted]:bg-white/20"
+      trigger={
+        <button
+          data-ui="tv-profile-trigger"
+          aria-label={user.Name || t`Account`}
+          className="flex items-center gap-3 rounded-full border border-white/30 px-5 py-2 text-lg text-white outline-none focus-visible:bg-white/25"
+        >
+          <YouIcon />
+          <span className="max-w-32 truncate">{user.Name || t`Account`}</span>
+          <BiChevronDown aria-hidden className="size-5 text-white/60" />
+        </button>
+      }
+    >
+      {choices.map((profile, index) => (
+        <DropdownMenuItem
+          key={profile.user.Id}
+          disabled={busy}
+          aria-label={profile.user.Name || t`Account`}
+          onSelect={async (event) => {
+            event.preventDefault();
+            if (profile.user.Id === user.Id) {
+              setOpen(false);
+              return;
+            }
+            setError(false);
+            setBusy(true);
+            try {
+              await switchUser(profile.user.Id);
+              setOpen(false);
+            } catch {
+              setError(true);
+            } finally {
+              setBusy(false);
+            }
+          }}
+        >
+          <span
+            style={{ backgroundColor: colors[index % colors.length] }}
+            className="flex size-11 shrink-0 items-center justify-center rounded-full"
+          >
+            <UserAvatar
+              name={profile.user.Name}
+              src={profile.avatar}
+              className="size-11 !bg-transparent text-xl"
+            />
+          </span>
+          <span className="flex-1 truncate">{profile.user.Name}</span>
+          {profile.user.Id === user.Id ? (
+            <BiCheck aria-label={t`Current profile`} />
+          ) : profile.needs ? (
+            <BiLockAlt aria-label={t`Protected profile`} />
+          ) : null}
+        </DropdownMenuItem>
+      ))}
+      <DropdownMenuSeparator className="mx-1 bg-white/15" />
+      <DropdownMenuItem onSelect={() => navigate(to.settings('account'))}>
+        <BiCog aria-hidden />
+        {t`Manage Profiles`}
+      </DropdownMenuItem>
+      {profiles.isError && (
+        <DropdownMenuLabel>{t`Unable to load profiles`}</DropdownMenuLabel>
+      )}
+      {error && (
+        <DropdownMenuLabel role="alert">{t`Unable to switch profiles. Try again.`}</DropdownMenuLabel>
+      )}
+    </DropdownMenu>
+  );
+}
