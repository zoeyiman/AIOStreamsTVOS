diff --git a/packages/web/src/lib/settings/tv-visibility.ts b/packages/web/src/lib/settings/tv-visibility.ts
index ecfc9c4..0c3effe 100644
--- a/packages/web/src/lib/settings/tv-visibility.ts
+++ b/packages/web/src/lib/settings/tv-visibility.ts
@@ -7,6 +7,7 @@ export function useVisibleTvControls(surface: TvControlSurface) {
   const [hidden] = useSetting(settings.tvVisibility);
   return (name: string) =>
     !appleTv() ||
