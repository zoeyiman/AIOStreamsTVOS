diff --git a/packages/web/src/styles.css b/packages/web/src/styles.css
index bb898f8..df488da 100644
--- a/packages/web/src/styles.css
+++ b/packages/web/src/styles.css
@@ -855,3 +855,91 @@ body:has([data-ui='sources-page']) :is([data-ui='top-tabs'], [data-ui='corner-me
 [data-tv] [data-apple-transport] [data-ui='player-live'] { order: 1; }
 [data-tv] [data-apple-transport] [data-ui='recent-live-channels'] { order: 2; }
 [data-tv] [data-ui='top-tabs-end']:has([data-ui='top-tabs-actions']:empty) { visibility: hidden; }
+
+/* Source selection is a full-screen page on Apple TV, including the in-player picker. */
+[data-tv] :is(.UI-Modal__content, .UI-Drawer__content)[data-name='versions'][data-apple-sources] {
+  position: fixed !important;
+  inset: 0 !important;
+  margin: 0 !important;
+  width: 100vw !important;
+  max-width: none !important;
+  height: 100dvh !important;
+  max-height: none !important;
+  border: 0 !important;
+  border-radius: 0 !important;
+  transform: none !important;
+  animation: none !important;
+  background: var(--background, #1b1d23) !important;
+}
+[data-tv] :is(.UI-Modal__content, .UI-Drawer__content)[data-name='versions'][data-apple-sources] > :is(.UI-Modal__header, .UI-Drawer__header) {
+  padding-top: max(1.25rem, env(safe-area-inset-top));
+}
+
+/* Keep details fluid within the available width; long pages remain scrollable. */
+[data-tv] [data-ui='item-page'],
+[data-tv] [data-ui='item-body'],
+[data-tv] [data-ui='item-header'] {
+  min-width: 0;
+  max-width: 100%;
+  box-sizing: border-box;
+}
+[data-tv] [data-ui='item-page'] { min-height: 100dvh; }
+[data-tv] [data-ui='item-body'] {
+  padding-block-start: max(clamp(2rem, 8dvh, 6rem), env(safe-area-inset-top));
+  padding-block-end: max(3rem, env(safe-area-inset-bottom));
+  padding-inline-start: max(clamp(1rem, 3vw, 4rem), env(safe-area-inset-left));
+  padding-inline-end: max(clamp(1rem, 3vw, 4rem), env(safe-area-inset-right));
+}
+[data-tv] [data-ui='item-header'] { align-items: flex-start; }
+[data-tv] [data-ui='item-header'] > div { max-width: 100%; }
+[data-tv] [data-ui='item-title'],
+[data-tv] [data-ui='item-tagline'],
+[data-tv] [data-ui='item-detail'] dd { overflow-wrap: anywhere; }
+[data-tv] [data-ui='item-logo'] {
+  max-height: clamp(3rem, 13dvh, 8rem);
+  max-width: min(26rem, 100%);
+}
+[data-tv] [data-ui='item-actions'] { flex-wrap: wrap; }
+[data-tv] [data-ui='item-header'] [data-ui='item-poster'] {
+  width: clamp(6rem, 15vw, 12rem);
+  max-height: 42dvh;
+  object-fit: contain;
+}
+[data-tv] :is(.UI-Modal__content, .UI-Drawer__content)[data-apple-detail-expanded] {
+  position: fixed !important;
+  inset: 0 !important;
+  margin: 0 !important;
+  width: 100vw !important;
+  max-width: none !important;
+  height: 100dvh !important;
+  max-height: none !important;
+  border: 0 !important;
+  border-radius: 0 !important;
+  transform: none !important;
+  animation: none !important;
+  overflow-y: auto !important;
+}
+[data-tv] [data-ui='sources-layout'] { min-width: 0; }
+[data-tv] [data-ui='sources-summary'] {
+  overflow-wrap: anywhere;
+  padding-block: 1rem;
+  scroll-padding-block: 1rem;
+}
+[data-tv] [data-ui='sources-summary'] > img {
+  flex-shrink: 0;
+  max-height: 36dvh;
+  max-width: 100%;
+}
+@media (max-width: 800px) {
+  [data-tv] [data-ui='sources-layout'] {
+    grid-template-columns: minmax(0, 1fr);
+    overflow-y: auto;
+  }
+  [data-tv] [data-ui='sources-layout'] > :first-child { min-height: 60dvh; }
+  [data-tv] [data-ui='sources-summary'] { overflow-y: visible; }
+  [data-tv] [data-ui='item-header'] { gap: 1rem; }
+}
+@media (max-height: 600px) {
+  [data-tv] [data-ui='item-body'] { padding-block-start: max(1.5rem, env(safe-area-inset-top)); }
+  [data-tv] [data-ui='item-logo'] { max-height: 15dvh; }
+}
