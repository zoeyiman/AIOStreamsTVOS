@@ -0,0 +1,248 @@
+import React from 'react';
+import { t } from '@lingui/core/macro';
+import { Trans } from '@lingui/react/macro';
+import {
+  DropdownMenu,
+  DropdownMenuItem,
+  DropdownMenuSub,
+} from '@aiostreams/ui/dropdown-menu';
+import { TextInput } from '@aiostreams/ui/text-input';
+import { BiCheck, BiChevronDown, BiSearch } from 'react-icons/bi';
+import { ChannelCard } from '@/features/live-tv/channel-card';
+import {
+  ALL,
+  FAVOURITES,
+  RECENT,
+  type ChannelGroup,
+} from '@/features/live-tv/live-tv';
+import { focusOn } from '@/lib/input';
+import type { BaseItemDto } from '@/lib/jellyfin/types';
+
+export function TvChannelToolbar({
+  group,
+  groups,
+  groupsLoading,
+  onGroup,
+  search,
+  onSearch,
+  onGuide,
+}: {
+  group: string;
+  groups: ChannelGroup[];
+  groupsLoading: boolean;
+  onGroup(id: string): void;
+  search: string;
+  onSearch(value: string): void;
+  onGuide?(): void;
+}) {
+  const [submenu, setSubmenu] = React.useState(false);
+  const groupsTrigger = React.useRef<HTMLDivElement>(null);
+  const collections = [
+    { id: ALL, name: t`All Channels` },
+    { id: RECENT, name: t`Recently Watched` },
+    { id: FAVOURITES, name: t`Favorites` },
+  ];
+  const selection =
+    collections.find((entry) => entry.id === group) ??
+    groups.find((entry) => entry.id === group);
+  const item = ({ id, name }: ChannelGroup) => (
+    <DropdownMenuItem
+      key={id}
+      role="menuitemradio"
+      aria-checked={id === group}
+      textValue={name}
+      onSelect={() => onGroup(id)}
+    >
+      <span className="min-w-0 flex-1 truncate">{name}</span>
+      {id === group && <BiCheck aria-hidden className="shrink-0" />}
+    </DropdownMenuItem>
+  );
+
+  return (
+    <div data-ui="live-toolbar" className="flex flex-none items-center gap-3">
+      <DropdownMenu
+        data-ui="live-filter-menu"
+        align="start"
+        sideOffset={8}
+        itemClass="gap-3 px-3 py-2.5"
+        subTriggerClass="gap-3 px-3 py-2.5"
+        subContentClass="live-filter-groups"
+        onOpenChange={(open) => {
+          if (!open) setSubmenu(false);
+        }}
+        trigger={
+          <button type="button" data-ui="live-filter" data-focus="own">
+            <span className="truncate">
+              {selection?.name ?? t`All Channels`}
+            </span>
+            <BiChevronDown aria-hidden className="shrink-0 text-xl" />
+          </button>
+        }
+      >
+        {collections.map(item)}
+        <DropdownMenuSub
+          open={submenu}
+          onOpenChange={setSubmenu}
+          triggerProps={{ ref: groupsTrigger }}
+          triggerContent={<Trans>Groups</Trans>}
+          onEscapeKeyDown={(event) => {
+            event.preventDefault();
+            setSubmenu(false);
+            if (groupsTrigger.current) focusOn(groupsTrigger.current);
+          }}
+        >
+          {groups.map(item)}
+          {!groups.length && (
+            <DropdownMenuItem disabled>
+              {groupsLoading ? (
+                <Trans>Loading groups…</Trans>
+              ) : (
+                <Trans>No channel groups</Trans>
+              )}
+            </DropdownMenuItem>
+          )}
+        </DropdownMenuSub>
+      </DropdownMenu>
+      {onGuide && (
+        <button
+          type="button"
+          data-ui="live-search-clear"
+          data-focus="own"
+          onClick={onGuide}
+        >
+          <Trans>Guide</Trans>
+        </button>
+      )}
+      <div className="ms-auto w-64 min-w-0">
+        <TextInput
+          data-ui="live-channel-search"
+          type="search"
+          autoComplete="off"
+          enterKeyHint="search"
+          aria-label={t`Search channels`}
+          placeholder={t`Search channels`}
+          leftIcon={<BiSearch aria-hidden className="text-lg" />}
+          value={search}
+          onValueChange={onSearch}
+          onInput={(event) => onSearch(event.currentTarget.value)}
+        />
+      </div>
+      {!!search && (
+        <button
+          type="button"
+          data-ui="live-search-clear"
+          data-focus="own"
+          onClick={() => {
+            const input = document.querySelector<HTMLElement>(
+              '[data-ui=live-channel-search]'
+            );
+            if (input) focusOn(input);
+            onSearch('');
+          }}
+        >
+          <Trans>Clear search</Trans>
+        </button>
+      )}
+    </div>
+  );
+}
+
+export function TvChannelGrid({
+  channels,
+  rows,
+  term,
+  active,
+  schedules,
+  now,
+  loading,
+  error,
+  hasMore,
+  onMore,
+  onFocus,
+  onPlay,
+}: {
+  channels: BaseItemDto[];
+  rows?: number[];
+  term: string;
+  active: number;
+  schedules: ReadonlyMap<string, BaseItemDto[]>;
+  now: number;
+  loading: boolean;
+  error: boolean;
+  hasMore: boolean;
+  onMore(): void;
+  onFocus(row: number): void;
+  onPlay(channel: BaseItemDto): void;
+}) {
+  const scroll = React.useRef<HTMLDivElement>(null);
+  const more = React.useRef<HTMLDivElement>(null);
+  const load = React.useRef(onMore);
+  load.current = onMore;
+  React.useEffect(() => {
+    if (!scroll.current || !more.current || !hasMore || error || loading)
+      return;
+    const observer = new IntersectionObserver(
+      ([entry]) => {
+        if (entry?.isIntersecting) load.current();
+      },
+      { root: scroll.current, rootMargin: '0px 0px 200px' }
+    );
+    observer.observe(more.current);
+    return () => observer.disconnect();
+  }, [hasMore, error, loading, channels.length]);
+
+  const displayed = rows ?? channels.map((_, index) => index);
+  const entry = displayed.includes(active) ? active : displayed[0];
+  return (
+    <div ref={scroll} data-ui="live-grid-scroll">
+      <div
+        data-ui="live-channel-grid"
+        data-search={term}
+        aria-label={t`Live TV channels`}
+      >
+        {displayed.map((index) => {
+          const channel = channels[index];
+          return (
+            <div
+              key={channel.Id}
+              data-live-row={index}
+              data-nav-start={index === entry || undefined}
+              className="min-w-0"
+              onFocus={(event) => {
+                if ((event.target as Element).closest('[data-ui=wide-card]'))
+                  onFocus(index);
+              }}
+            >
+              <ChannelCard
+                channel={channel}
+                programmes={schedules.get(channel.Id!)}
+                now={now}
+                onPlay={onPlay}
+              />
+            </div>
+          );
+        })}
+      </div>
+      {error ? (
+        <p role="status">
+          <Trans>Could not load channels.</Trans>
+        </p>
+      ) : loading ? (
+        <p role="status">
+          <Trans>Loading channels…</Trans>
+        </p>
+      ) : (
+        !displayed.length && (
+          <p role="status">
+            {rows ? (
+              <Trans>No matching channels.</Trans>
+            ) : (
+              <Trans>No channels in this group.</Trans>
+            )}
+          </p>
+        )
+      )}
+      {hasMore && <div ref={more} aria-hidden="true" />}
+    </div>
+  );
+}
