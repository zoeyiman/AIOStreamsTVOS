diff --git a/packages/web/src/styles.css b/packages/web/src/styles.css
index db5fed4..29358f6 100644
--- a/packages/web/src/styles.css
+++ b/packages/web/src/styles.css
@@ -1057,3 +1057,23 @@ body:has([data-ui='sources-page']) :is([data-ui='top-tabs'], [data-ui='corner-me
     flex: none;
   }
 }
+
+/* The glass hugs the tabs rather than filling unused grid space. */
+[data-apple-top-tabs] > .grid > :nth-child(2) {
+  width: max-content;
+  justify-self: center;
+}
+[data-tv] [data-ui='channel-details'] { overflow-y: auto; }
+[data-tv] [data-ui='live-hero'] [data-name='overview'] {
+  display: block;
+  -webkit-line-clamp: unset;
+  overflow: visible;
+  white-space: pre-line;
+}
+[data-tv] [data-ui='pause-details'] {
+  max-height: 78dvh;
+  overflow-y: auto;
+  padding-block: 1rem;
+  padding-inline-end: 1rem;
+  scrollbar-width: none;
+}
